{
  "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
  "files": {
    "includes": ["**", "!dist", "!src/api/schema.d.ts", "!playwright-report", "!test-results", "!.e2e", "!node_modules"]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "javascript": { "formatter": { "quoteStyle": "single", "semicolons": "asNeeded" } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": "error",
      "security": { "preset": "recommended", "noDangerouslySetInnerHtml": "error" }
    }
  }
}
