{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bump-minor-pre-major": true,
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Features"
    },
    {
      "type": "fix",
      "section": "Bug Fixes"
    },
    {
      "type": "perf",
      "section": "Performance"
    },
    {
      "type": "refactor",
      "section": "Refactoring"
    },
    {
      "type": "docs",
      "section": "Documentation"
    },
    {
      "type": "chore",
      "section": "Chores",
      "hidden": true
    },
    {
      "type": "ci",
      "section": "CI",
      "hidden": true
    },
    {
      "type": "build",
      "section": "Build",
      "hidden": true
    },
    {
      "type": "test",
      "section": "Tests",
      "hidden": true
    }
  ],
  "packages": {
    ".": {
      "release-type": "go",
      "extra-files": [
        {
          "type": "json",
          "path": "band/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "band/package-lock.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "band/package-lock.json",
          "jsonpath": "$.packages[''].version"
        },
        {
          "type": "json",
          "path": "band/plugin/.claude-plugin/plugin.json",
          "jsonpath": "$.version"
        },
        {
          "type": "generic",
          "path": "deploy/docker-compose.yml"
        }
      ],
      "initial-version": "0.1.0"
    }
  }
}
