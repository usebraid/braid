# Copy to .env and replace every CHANGE_ME. Passwords end up in URLs: use hex only (openssl rand -hex 24).
POSTGRES_PASSWORD=CHANGE_ME
BRAID_DB_OWNER_PASSWORD=CHANGE_ME
BRAID_DB_APP_PASSWORD=CHANGE_ME
BRAID_PUBLIC_URL=http://localhost:8080
# Your OIDC provider's issuer URL, see docs/oidc-providers (usebraid.dev/docs/oidc-providers/).
BRAID_OIDC_ISSUER=CHANGE_ME
# From the OIDC client you create in your provider.
BRAID_OIDC_CLIENT_ID=CHANGE_ME
BRAID_OIDC_CLIENT_SECRET=CHANGE_ME
BRAID_OIDC_ADMIN_GROUP=braid-admins
# Optional: image tag of ghcr.io/usebraid/braid-server (default: current release).
# BRAID_VERSION=
